<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="generator" content="<%= Pluto.generator %>">
  <title><%= site.title %></title>
  <link rel="alternate" type="application/atom+xml" href="atom.xml" title="<%= site.title %>">
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, system-ui, sans-serif; max-width: 720px; margin: 2rem auto; padding: 0 1rem; line-height: 1.5; color: #222; }
    h1 { margin-bottom: 0; }
    .feed-link { color: #666; font-size: 0.9rem; }
    article { padding: 1rem 0; border-bottom: 1px solid #eee; }
    article h2 { font-size: 1.1rem; margin: 0 0 0.25rem; }
    .meta { color: #666; font-size: 0.85rem; }
    a { color: #06c; text-decoration: none; }
    a:hover { text-decoration: underline; }
  </style>
</head>
<body>
  <header>
    <h1><%= site.title %></h1>
    <p class="feed-link">Combined feed: <a href="atom.xml">atom.xml</a></p>
  </header>
  <main>
<% site.items.latest.limit(50).each do |item| %>
    <article>
      <h2><%= link_to item.title, item.url %></h2>
      <p class="meta">
        <%= link_to item.feed.title, item.feed.url %>
        &middot;
        <%= item.published.strftime('%Y-%m-%d') if item.published %>
      </p>
    </article>
<% end %>
  </main>
</body>
</html>
